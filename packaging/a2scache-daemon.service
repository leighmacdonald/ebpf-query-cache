[Unit]
Description=a2scache A2S query refresh daemon
Documentation=man:a2scache(8)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/a2scache serve --config /etc/a2scache.toml
Restart=on-failure
RestartSec=2
# serve: open/write the pinned BPF maps (BPF), bind an ephemeral UDP socket
# per backend (NET_BIND_SERVICE is not needed: unprivileged ports/ephemeral)
AmbientCapabilities=CAP_BPF
CapabilityBoundingSet=CAP_BPF
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/sys/fs/bpf

[Install]
WantedBy=multi-user.target
